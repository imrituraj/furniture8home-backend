// Furniture8home backend: the shop API (/api/*) and uploaded photos (/media/*).
// The storefront and the admin dashboard are hosted on Vercel.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "furniture8home-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      // No database_id: Wrangler creates the database on the first deploy.
      // The Worker creates its tables and loads the starter catalog on first use.
      "binding": "DB",
      "database_name": "furniture8home"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // Sites allowed to call the public shop API, comma-separated
    "STOREFRONT_ORIGIN": "https://furniture8home.com,https://www.furniture8home.com",
    // Site allowed to call the admin API (log in, manage orders, products, categories)
    "ADMIN_ORIGIN": "https://admin.furniture8home.com"
  },
  "observability": {
    "enabled": true
  }
  // Secrets (set with `npx wrangler secret put NAME`, or in the Cloudflare dashboard):
  //   ADMIN_PIN                 6–8 digits, required to log in to the admin dashboard
  //   RAZORPAY_KEY_ID           \  online payment is hidden at checkout
  //   RAZORPAY_KEY_SECRET       /  until both are set
  //   RAZORPAY_WEBHOOK_SECRET   optional, for https://<backend>/api/razorpay/webhook
}
